# The local simulator is configured automatically by pnpm dev:local.
# For real MDK development, keep credentials in ignored .env.mdk.local.
MDK_ACCESS_TOKEN=
MDK_MNEMONIC=
MDK_WEBHOOK_SECRET=
PAYMENT_MODE=mdk

# Next.js server -> Convex event bridge; share the secret with Convex.
# CONVEX_SITE_URL is the backend's .convex.site URL, not the public app domain.
PAYMENT_BRIDGE_SECRET=
CONVEX_SITE_URL=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLOCK_DURATION=60

# Also configure these in the intended Convex deployment (never auto-copy to production).
# For the hosted app: PAYMENT_BRIDGE_URL=https://lastpaywins.lwn.lol
# pnpm dev:local sets a loopback URL instead.
PAYMENT_BRIDGE_URL=
PAYMENTS_ENABLED=false
PAYMENT_NOTIFICATIONS_ENABLED=false
INVOICE_AMOUNT=100
MDK_FEE_RESERVE_BPS=200
PAYOUT_RESERVE_SATS_PER_BID=5
